{
  "name": "emg-prosthesis-system",
  "version": "1.0.0",
  "type": "module",
  "description": "Biomedical EMG Gesture Recognition System for Prosthetic Hand Control",
  "private": true,
  "scripts": {
    "dev": "node scripts/predev.mjs && nuxt dev",
    "build": "nuxt build",
    "start": "node .output/server/index.mjs",
    "preview": "nuxt preview",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio --port 5555",
    "prisma:seed": "npx tsx prisma/seed.ts",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@nuxt/ui": "^2.18.4",
    "@pinia/nuxt": "^0.5.5",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "chart.js": "^4.4.6",
    "concurrently": "^9.1.0",
    "dayjs": "^1.11.13",
    "exceljs": "^4.4.0",
    "h3": "^1.13.0",
    "jose": "^5.9.6",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^3.8.4",
    "nuxt": "^3.14.0",
    "pinia": "^2.2.6",
    "vue": "^3.5.13",
    "vue-chartjs": "^5.3.2",
    "vue-router": "^4.4.5",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nuxt/devtools": "^1.6.1",
    "@nuxtjs/tailwindcss": "^6.12.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.9.3",
    "@types/ws": "^8.5.13",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vue-tsc": "^2.1.10"
  }
}
